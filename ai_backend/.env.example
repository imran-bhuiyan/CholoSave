# ---------------------------------------------------------------------------
# CholoSave AI tips service (ai_backend/generate_tips.py)
#
# Local development: cp .env.example .env   then fill in GROQ_API_KEY and run
#   FLASK_DEBUG=1 python generate_tips.py
#
# Production: prefer real environment variables on the service unit (gunicorn
# ignores FLASK_DEBUG entirely). NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Required: API key for the Groq API (https://console.groq.com). The service
# will fail to generate advice without it.
GROQ_API_KEY=

# Comma-separated list of origins allowed to call /generate_tips (CORS).
# Defaults below keep local development working.
# [PRODUCTION] Set to the public frontend origin(s), e.g.
#   ALLOWED_ORIGINS=https://your-domain.example
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local development only. Never enable in production (exposes the Werkzeug
# interactive debugger, which allows remote code execution).
FLASK_DEBUG=0
