# ---------------------------------------------------------------------------
# CholoSave environment configuration
#
# Local development:  cp .env.example .env && php artisan key:generate
# Production:         copy this file to .env on the server, then set every
#                     value marked [PRODUCTION] below. NEVER commit the real
#                     .env file, and never commit real credentials anywhere.
# ---------------------------------------------------------------------------

APP_NAME=CholoSave
APP_ENV=local
# [PRODUCTION] APP_ENV=production
APP_KEY=
# Generate on the server with: php artisan key:generate   (never commit it)
APP_DEBUG=true
# [PRODUCTION] APP_DEBUG=false  (leaves stack traces / env values exposed if true)
APP_URL=http://localhost
# [PRODUCTION] APP_URL=https://your-domain.example  (no trailing slash)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# [PRODUCTION] LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cholosave_db_swe
DB_USERNAME=root
DB_PASSWORD=
# [PRODUCTION] Use a dedicated, least-privilege MySQL user with a strong
# password instead of root with an empty password.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# [PRODUCTION] Serve the app over HTTPS and set SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (OTP delivery: payment OTP + password reset OTP) -----------------
# Local development keeps MAIL_MAILER=log (messages are written to
# storage/logs/laravel.log and nothing is actually sent).
# [PRODUCTION] REQUIRED: switch to a real SMTP account, otherwise the payment
# and password-reset OTP emails will never reach users.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# [PRODUCTION] MAIL_FROM_ADDRESS must be a sender your SMTP account may use,
# e.g. "noreply@your-domain.example" (misconfigured senders get rejected or
# land in spam).
MAIL_FROM_NAME="${APP_NAME}"
# TLS: leave MAIL_SCHEME unset for STARTTLS (port 587), or set MAIL_SCHEME=smtps
# for implicit TLS (port 465).
# MAIL_SCHEME=smtps

# --- AI tips microservice (ai_backend/generate_tips.py) ----------------------
# Base URL the browser uses to reach the Flask AI service. Keep the local
# default for development (run `python generate_tips.py` inside ai_backend/).
# [PRODUCTION] Set to the public HTTPS URL the service is served under, e.g.
# AI_SERVICE_URL=https://ai.your-domain.example
AI_SERVICE_URL=http://localhost:5000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
